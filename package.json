{
  "name": "silk",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -pt run build",
    "typecheck": "yarn workspaces foreach -A -pt run typecheck",
    "test": "yarn workspaces foreach -A -pt run test",
    "test:packed": "node scripts/packed-consumer-check.mjs",
    "test:perf": "node scripts/perf-budgets.mjs",
    "docs": "yarn workspace @reactive/silk-docs storybook",
    "docs:build": "yarn workspace @reactive/silk-docs build:storybook",
    "test:storybook": "yarn workspace @reactive/silk-docs test:storybook:ci",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn build && node scripts/release-ci.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
