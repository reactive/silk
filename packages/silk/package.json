{
  "name": "@reactive/silk",
  "version": "0.0.0",
  "description": "Long-lived design system foundation for React — semantic themes, Linaria CSS, Radix behavior",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rstest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@linaria/core": "^8.1.1"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^1.4.5",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "^0.11.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wyw-in-js/webpack-loader": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "webpack": "^5"
  }
}
