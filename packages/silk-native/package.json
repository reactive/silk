{
  "name": "@reactive/silk-native",
  "version": "0.0.0",
  "description": "React Native renderer for Silk — semantic themes and recipe contracts without CSS variables",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gesture": {
      "types": "./dist/gesture/index.d.ts",
      "import": "./dist/gesture/index.js",
      "default": "./dist/gesture/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#floating-layer": {
      "react-native": "./dist/overlay/layer.modal.js",
      "default": "./dist/overlay/layer.dom.js"
    },
    "#in-text": {
      "react-native": "./dist/components/inText.js",
      "default": "./dist/components/inText.dom.js"
    },
    "#motion-list": {
      "react-native": "./dist/components/MotionList/MotionList.layout.js",
      "default": "./dist/components/MotionList/MotionList.dom.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rstest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": ">=0.83.0",
    "react-native-gesture-handler": ">=3.3.0 <4",
    "react-native-reanimated": ">=4.6.0 <5",
    "react-native-worklets": ">=0.12.0 <1"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-dismissable-layer": "^1.1.18",
    "@radix-ui/react-focus-scope": "^1.3.1",
    "@reactive/silk-core": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.28.5",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/core": "^0.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.6.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.2",
    "typescript": "^7.0.2"
  }
}
